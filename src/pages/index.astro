---
import Layout from '../layouts/Layout.astro';
import Portfolio from '../components/Portfolio.vue';
import { getRecentTrack } from '../lib/lastfm';
import { getContributions } from '../lib/contributions';

// En build time (y en cada recarga con `pnpm dev`). Al cliente solo llegan los datos de la canción.
const [track, contrib] = await Promise.all([getRecentTrack(), getContributions()]);
---
<Layout title="Joan Rojas — Product Engineer">
  <Portfolio client:load hero="editorial" track={track} contrib={contrib} />
</Layout>
